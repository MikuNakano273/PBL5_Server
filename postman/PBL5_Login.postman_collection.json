{
  "info": {
    "_postman_id": "71a72c9b-0692-4fd2-a79a-99eb25e025ea",
    "name": "PBL5 - Mobile Login Tests",
    "description": "Tests the mobile login API with valid credentials, uppercase email, invalid password, and missing fields.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Login successfully",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Response contains a bearer token pair', function () {",
              "  const body = pm.response.json();",
              "  pm.expect(body.access_token).to.be.a('string').and.not.empty;",
              "  pm.expect(body.refresh_token).to.be.a('string').and.not.empty;",
              "  pm.expect(body.token_type).to.eql('bearer');",
              "  pm.environment.set('access_token', body.access_token);",
              "  pm.environment.set('refresh_token', body.refresh_token);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{login_email}}\",\n  \"password\": \"{{login_password}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/mobile/v1/auth/login",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "mobile",
            "v1",
            "auth",
            "login"
          ]
        }
      }
    },
    {
      "name": "Login accepts uppercase email",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Response contains access token', function () {",
              "  pm.expect(pm.response.json().access_token).to.be.a('string').and.not.empty;",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{uppercase_login_email}}\",\n  \"password\": \"{{login_password}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/mobile/v1/auth/login",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "mobile",
            "v1",
            "auth",
            "login"
          ]
        }
      }
    },
    {
      "name": "Login rejects invalid password",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 401', function () {",
              "  pm.response.to.have.status(401);",
              "});",
              "",
              "pm.test('Response contains an error', function () {",
              "  const body = pm.response.json();",
              "  pm.expect(body.detail || body.error || body.message).to.exist;",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{login_email}}\",\n  \"password\": \"wrong-password\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/mobile/v1/auth/login",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "mobile",
            "v1",
            "auth",
            "login"
          ]
        }
      }
    },
    {
      "name": "Login rejects missing password",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 422', function () {",
              "  pm.response.to.have.status(422);",
              "});",
              "",
              "pm.test('Response contains validation details', function () {",
              "  const body = pm.response.json();",
              "  pm.expect(body.detail).to.be.an('array').and.not.empty;",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{login_email}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/mobile/v1/auth/login",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "mobile",
            "v1",
            "auth",
            "login"
          ]
        }
      }
    }
  ]
}
